{
  "name": "hotel-management-system",
  "version": "0.1.0",
  "private": true,
  "description": "小型酒店管理系统（HMS）— pnpm monorepo（核心业务已实现；需求基线 v1.0 已批准；walk-in UI / E2E 待补）",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev:server": "pnpm --filter @hms/server dev",
    "dev:web": "pnpm --filter @hms/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "db:migrate": "pnpm --filter @hms/server db:migrate",
    "db:deploy": "pnpm --filter @hms/server db:deploy",
    "db:seed": "pnpm --filter @hms/server db:seed",
    "compose:config": "docker compose --env-file .env.example config --quiet && docker compose -f compose.prod.yml --env-file .env.example config --quiet"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vue-eslint-parser": "^10.4.1"
  }
}
