# 前端环境变量示例（仅占位值，不得写入真实密钥）
# 复制为 .env.local 覆盖本机配置；.env.local 已被 .gitignore 排除。
# 开发环境默认经 Vite proxy 同源转发到后端，避免跨域 Cookie / CSRF 问题。

# API 基础路径（同源部署固定为 /api/v1；直连后端时可改为 http://localhost:3000/api/v1）
VITE_API_BASE_URL=/api/v1

# 请求超时（毫秒）
VITE_REQUEST_TIMEOUT_MS=15000

# 仅开发服务器使用：/api 代理目标
VITE_DEV_PROXY_TARGET=http://localhost:3000
