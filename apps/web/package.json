{
  "name": "@hms/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HMS 前端 SPA（Vue 3 + Element Plus；基础设施与后台布局已就绪，业务页面待开发）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "vue-tsc --noEmit -p tsconfig.json && eslint . && prettier --check . && vitest run"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@hms/shared": "workspace:*",
    "axios": "^1.20.0",
    "element-plus": "^2.14.7",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.13"
  }
}
