# 后端环境变量示例（全部为占位值，不含真实密钥；复制为 .env 后替换）
# 注意：环境变量校验 fail-fast（ADR-007），占位值无法启动，属预期行为。
# 连接串中的密码如含特殊字符（如 #、@、:、/），必须进行 URL 编码，
# 否则 .env 解析或 URL 解析会截断（例如 # 会被 dotenv 视为行内注释）。

NODE_ENV=development
PORT=3000

# 运行库连接（DML 账号；本地开发指向 docker compose 暴露的 3307 端口）
# 建议使用无特殊字符的强随机密码（base64url）以避免 URL 编码问题
DATABASE_URL=mysql://hms_app:REPLACE_APP_PASSWORD@127.0.0.1:3307/hotel
# 迁移专用连接（DDL 账号；缺省回退 DATABASE_URL，见 database-design.md §7）
MIGRATION_DATABASE_URL=mysql://root:REPLACE_ROOT_PASSWORD@127.0.0.1:3307/hotel

SESSION_TTL_HOURS=8
LOG_LEVEL=info

# 证件号 HMAC 查重密钥 / AES-256-GCM 加密密钥（32 字节 base64）
# 生成：node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
GUEST_ID_HMAC_KEY=REPLACE_WITH_BASE64_32_BYTES
GUEST_ID_CIPHER_KEY=REPLACE_WITH_BASE64_32_BYTES

# 仅 prisma/seed.ts 使用（首次初始化管理员，密码绝不硬编码）
ADMIN_INITIAL_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# 显式允许的跨域源（默认无；同源部署不启用跨域）
# CORS_ORIGIN=http://localhost:5173
