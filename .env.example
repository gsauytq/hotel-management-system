# =====================================================================
# Docker Compose 环境变量示例（全部为占位值，不含任何真实密钥）
# 用法：cp .env.example .env 并替换全部 REPLACE_* 占位值；.env 已被 .gitignore 排除。
# 生成随机值示例（PowerShell）：
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# 密钥生成后请妥善保管；GUEST_ID_* 轮换需重加密数据（本期不支持，见 security-design §10）。
# =====================================================================

# --- MySQL（compose dev / prod 共用）---
MYSQL_ROOT_PASSWORD=REPLACE_ROOT_PASSWORD
MYSQL_DATABASE=hotel
MYSQL_USER=hms_app
MYSQL_PASSWORD=REPLACE_APP_PASSWORD

# 开发 compose 暴露到宿主的端口（默认 3307，避免与本机 MySQL 冲突）
MYSQL_HOST_PORT=3307

# --- api ---
SESSION_TTL_HOURS=8
LOG_LEVEL=info
GUEST_ID_HMAC_KEY=REPLACE_WITH_BASE64_32_BYTES
GUEST_ID_CIPHER_KEY=REPLACE_WITH_BASE64_32_BYTES

# 仅 seed 使用（首次初始化管理员，≥10 位；绝不硬编码进镜像）
ADMIN_INITIAL_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# --- web / TLS ---
# 80 仅 301 跳转到 HTTPS；443 由 web 容器内 Nginx 终结 TLS。
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443
# 目录内必须包含 fullchain.pem 与 privkey.pem（只读挂载）；不要提交私钥。
TLS_CERT_DIR=./certs
# 可选：私有 CA / 自签证书校验文件，供 verify-deployment.sh 与本地冒烟使用。
# HMS_TLS_CA_FILE=./certs/fullchain.pem
#
# D2-c（HTTP 风险接受）当前未启用。若负责人另行批准，必须在 API 配置中增加
# COOKIE_SECURE 开关（默认跟随 NODE_ENV），不得用 NODE_ENV=development 绕过 Secure。
